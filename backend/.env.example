PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Local MongoDB Server; connect to this same URI in MongoDB Compass.
# Compass is a client and requires a local MongoDB Server to be running.
MONGO_TARGET=local
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/barangay_db

# To use Atlas instead, set MONGO_TARGET=atlas and provide your Atlas URI:
# MONGO_TARGET=atlas
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/barangay_db?retryWrites=true&w=majority